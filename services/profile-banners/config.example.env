# Copy to .env. Keep the real token out of Git and screenshots.
BOT_TOKEN=replace_with_BotFather_token
# Your numeric Telegram ID. Several moderators: comma-separated IDs.
ADMIN_IDS=123456789
# Usually the same as your ID: the bot sends moderation cards to this private chat.
ADMIN_CHAT_ID=123456789
PUBLIC_BASE_URL=https://banners.example.com
PORT=8080
DATA_DIR=./data
# Reserve space for the runtime, database and temporary files on a 1 GB host.
MAX_STORAGE_MB=600
MAX_PENDING=50
# Set to true ONLY behind your own trusted reverse proxy.
TRUST_PROXY=false
